# Base URL of the Rewind control-plane API.
#
# Local dev:   http://localhost:8010
# Deployed:    set to your API URL (e.g. https://rewind-api-xxxx.onrender.com)
#
# If this is unset or the API is unreachable/asleep, the UI automatically falls
# back to seeded "demo mode" data so the page always renders. You can deploy the
# frontend to Vercel with NO backend at all and it will still look alive.
NEXT_PUBLIC_REWIND_API=http://localhost:8010

# API key for the write endpoints (create / run / publish). Must match
# REWIND_API_KEY on the backend. Only needed if the backend has a key set;
# reads and scope-preview work without it. Leave blank for local dev.
NEXT_PUBLIC_REWIND_API_KEY=
